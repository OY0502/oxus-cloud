{
  "npm.packageManager": "pnpm",
  "npm.scriptExplorerAction": "run",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/pnpm-lock.yaml": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}"
}
