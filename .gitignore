# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules
/.pnpm-store/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
/*.code-workspace

# env files (keep .env.example tracked)
.env
.env.local
.env.*.local

# Accidental Supabase CLI state when run from monorepo root (canonical project: artifacts/oxus-cloud/supabase)
/supabase/.temp/

# Stray Trigger.dev scaffold at repo root (canonical config: artifacts/oxus-cloud/trigger.config.ts)
/trigger.config.ts
/src/trigger/

# Local production diagnostics and one-off repair artifacts
/artifacts/oxus-cloud/scripts/_*

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
